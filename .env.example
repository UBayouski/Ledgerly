# PayPal REST app credentials (Developer Dashboard -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX

# Model provider: google (default), anthropic, or vertex
LLM_PROVIDER=google
# Optional: model id override. Defaults: gemini-3.1-pro-preview (google, vertex), claude-opus-5-5 (anthropic)
LLM_MODEL=
# Optional: Anthropic reasoning effort (low | medium | high); ignored by other providers
LLM_EFFORT=medium

# google: Gemini through Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# anthropic: Claude through the Anthropic API (https://platform.claude.com)
ANTHROPIC_API_KEY=
# vertex: Gemini or Claude through Vertex AI. Auth is Application Default Credentials
# (gcloud auth application-default login) or a service-account key pasted as JSON.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
GOOGLE_CREDENTIALS_JSON=

# Optional: invoicer email shown on seeded invoices (must belong to the sandbox business account)
SEED_INVOICER_EMAIL=
